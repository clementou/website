---
import { links, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
	<nav class="footer-links" aria-label="Contact links">
		{
			links.map((link) => (
				<a
					href={link.href}
					data-umami-event={link.event}
					{...link.href.startsWith("http")
						? { target: "_blank", rel: "noopener" }
						: {}}
				>
					{link.label}
				</a>
			))
		}
	</nav>
	<nav class="footer-projects" aria-label="Personal projects">
		<span class="footer-projects-label">On the side</span>
		<a href="/fish" data-umami-event="project-click-fish">Fish</a>
		<span aria-hidden="true">·</span>
		<a href="/restaurants" data-umami-event="project-click-restaurants">Restaurants</a>
	</nav>
	<p class="footer-close">{site.location} · {year}</p>
</footer>
