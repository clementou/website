---
---

<div class="hero-art" aria-hidden="true">
	<canvas id="sea"></canvas>
</div>

<script>
	// A stormy sea in deep blue, painted in oil: splotched dabs of pigment,
	// a churned horizon where sky and water fight, storm masses pressing
	// down into the swell. Everything is a function of time.
	const canvas = document.getElementById("sea") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;
	const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

	const BG = "#0c1f33"; // must match --bg so the painting dissolves into the page
	const TAU = Math.PI * 2;

	// deep / mid / light / foam / green
	const PIGMENT = [
		[5, 15, 28],
		[38, 88, 138],
		[118, 166, 212],
		[204, 221, 236],
		[62, 122, 108],
	];

	type Blob = { dx: number; dy: number; rx: number; ry: number; rot: number };
	type Pt = { x: number; y: number; r: number };

	type Splotch = {
		x0: number;
		y0: number;
		v: number; // 0 horizon … 1 shore
		kind: number;
		a: number;
		drift: number;
		phase: number;
		flick: number;
		span: number;
		blobs: Blob[];
		path?: Pt[];
		rgb: number[];
	};

	type Mass = {
		x0: number;
		y: number;
		rx: number;
		ry: number;
		rot: number;
		drift: number;
		a: number;
		rgb: number[];
	};

	let W = 0;
	let H = 0;
	let dpr = 1;
	let dabs: Splotch[] = [];
	let churn: Splotch[] = [];
	let wakes: Splotch[] = [];
	let masses: Mass[] = [];
	let raf = 0;
	let last = 0;
	let t = 8; // start mid-motion, never from zero
	let running = false;

	const horizonY = () => H * 0.66;

	function resize() {
		const rect = canvas.parentElement!.getBoundingClientRect();
		dpr = Math.min(window.devicePixelRatio || 1, 1.5);
		W = rect.width;
		H = rect.height;
		canvas.width = Math.round(W * dpr);
		canvas.height = Math.round(H * dpr);
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		seed();
	}

	// a loaded-brush mark: lumps strung along a horizontal stroke,
	// never a clean shape and never a round dot
	function makeBlobs(len: number, th: number) {
		const n = 3 + Math.floor(Math.random() * 3);
		const blobs: Blob[] = [];
		let span = 0;
		for (let i = 0; i < n; i++) {
			const p = i / (n - 1) - 0.5;
			const dx = p * len * (0.85 + Math.random() * 0.3);
			const rx = (len / n) * (0.75 + Math.random() * 0.7);
			blobs.push({
				dx,
				dy: (Math.random() - 0.5) * th * 0.8,
				rx,
				ry: th * (0.5 + Math.random() * 0.6),
				rot: (Math.random() - 0.5) * 0.22,
			});
			span = Math.max(span, Math.abs(dx) + rx);
		}
		return { blobs, span };
	}

	// a foam smear: one connected ragged ribbon along a meandering line,
	// thick where the brush pressed and dying out at the edges
	function makeStreak(
		len: number,
		th: number,
		bend = 0,
		mode: "both" | "tail" = "both",
	) {
		const n = 10 + Math.floor(Math.random() * 6);
		const pts: Pt[] = [];
		let wander = 0;
		let span = 0;
		for (let i = 0; i < n; i++) {
			const p = i / (n - 1);
			wander = wander * 0.75 + (Math.random() - 0.5) * th * 0.7;
			const taper =
				mode === "tail"
					? 1 - p * 0.82
					: 0.22 + 0.78 * Math.pow(Math.sin(Math.PI * p), 0.6);
			const pt = {
				x: (p - 0.5) * len * (1 + (Math.random() - 0.5) * 0.08),
				y: wander + bend * p * p,
				r: Math.max(0.4, th * taper * (0.6 + Math.random() * 0.5)),
			};
			pts.push(pt);
			span = Math.max(span, Math.abs(pt.x) + pt.r);
		}
		return { pts, span };
	}

	// each mark carries its own slightly-off mix of the pigment
	function mix(kind: number) {
		const [r, g, b] = PIGMENT[kind];
		const j = kind === 3 ? 8 : 16;
		return [
			Math.round(r + (Math.random() - 0.5) * j),
			Math.round(g + (Math.random() - 0.5) * j),
			Math.round(b + (Math.random() - 0.5) * j * 1.4),
		];
	}

	function seed() {
		const yh = horizonY();
		const seaH = H - yh;

		dabs = [];
		const rows = 26;
		for (let i = 0; i < rows; i++) {
			const v = Math.pow((i + 0.6) / rows, 1.35);
			const y = yh + seaH * v;
			const len = 12 + 68 * v;
			const th = 1.6 + 6 * v;
			const count = Math.min(130, Math.ceil(W / (len * 0.9)));
			for (let j = 0; j < count; j++) {
				const roll = Math.random();
				// near the horizon the water carries the light
				let kind: number;
				if (roll < 0.035 && v > 0.12) kind = 3;
				else if (roll < (v < 0.2 ? 0.44 : 0.26)) kind = 2;
				else if (roll < (v < 0.2 ? 0.55 : 0.38)) kind = 4;
				else if (roll < (v > 0.45 ? 0.62 : 0.7)) kind = 1;
				else kind = 0;
				const foam = kind === 3;
				const streak = foam
					? makeStreak(
							len * (1.2 + Math.random() * 1.2),
							th * (0.55 + Math.random() * 0.55),
							(Math.random() - 0.5) * th * 1.6,
						)
					: null;
				const { blobs, span } = streak
					? { blobs: [], span: streak.span }
					: makeBlobs(
							len * (0.55 + Math.random() * 0.9),
							th * (0.6 + Math.random() * 0.8),
						);
				dabs.push({
					x0: Math.random() * W,
					y0: y + (Math.random() - 0.5) * seaH * 0.06,
					v,
					kind,
					a:
						kind === 3
							? 0.38 + Math.random() * 0.26
							: kind === 2
								? 0.18 + Math.random() * 0.22
								: kind === 4
									? 0.13 + Math.random() * 0.15
									: kind === 1
										? 0.2 + Math.random() * 0.22
										: 0.26 + Math.random() * 0.26,
					drift: (7 + 38 * v) * (0.7 + Math.random() * 0.6),
					phase: Math.random() * TAU,
					flick: 0.3 + Math.random() * 1.2,
					span,
					blobs,
					path: streak ? streak.pts : undefined,
					rgb: mix(kind),
				});
			}
		}

		// the churn: spray and spume thrown across the horizon itself,
		// so sky and sea never meet along a line
		churn = Array.from({ length: 110 }, () => {
			const roll = Math.random();
			const kind =
				roll < 0.36 ? 2 : roll < 0.46 ? 3 : roll < 0.64 ? 4 : roll < 0.88 ? 1 : 0;
			const streak =
				kind === 3
					? makeStreak(
							16 + Math.random() * 42,
							1.8 + Math.random() * 2.8,
							(Math.random() - 0.5) * 4,
						)
					: null;
			const { blobs, span } = streak
				? { blobs: [], span: streak.span }
				: makeBlobs(10 + Math.random() * 34, 1.4 + Math.random() * 2.6);
			return {
				x0: Math.random() * W,
				y0: yh + (Math.random() - 0.55) * H * 0.09,
				v: 0.2,
				kind,
				a:
					kind === 3
						? 0.34 + Math.random() * 0.24
						: kind === 2
							? 0.18 + Math.random() * 0.18
							: 0.14 + Math.random() * 0.16,
				drift: 26 + Math.random() * 44,
				phase: Math.random() * TAU,
				flick: 0.35 + Math.random() * 0.9,
				span,
				blobs,
				path: streak ? streak.pts : undefined,
				rgb: mix(kind),
			};
		});

		// breakers: flashes of white where the waterline collapses
		for (let i = 0; i < 7; i++) {
			const { pts, span } = makeStreak(
				28 + Math.random() * 52,
				2.4 + Math.random() * 3,
				(Math.random() - 0.5) * 5,
			);
			churn.push({
				x0: Math.random() * W,
				y0: yh + (Math.random() - 0.5) * H * 0.035,
				v: 0.15,
				kind: 3,
				a: 0.42 + Math.random() * 0.24,
				drift: 30 + Math.random() * 40,
				phase: Math.random() * TAU,
				flick: 0.4 + Math.random() * 0.8,
				span,
				blobs: [],
				path: pts,
				rgb: mix(3),
			});
		}

		// wakes: trails of foam dying off behind the wind
		wakes = Array.from({ length: 5 }, () => {
			const v = 0.35 + Math.random() * 0.6;
			const th = 2 + 6 * v;
			const { pts, span } = makeStreak(
				(36 + 70 * v) * (0.8 + Math.random() * 0.6),
				th,
				(Math.random() - 0.5) * th * 4,
				"tail",
			);
			return {
				x0: Math.random() * W,
				y0: yh + (H - yh) * v,
				v,
				kind: 3,
				a: 0.28 + Math.random() * 0.22,
				drift: 12 + 30 * v,
				phase: Math.random() * TAU,
				flick: 0.25 + Math.random() * 0.5,
				span,
				blobs: [],
				path: pts,
				rgb: mix(3),
			};
		});

		// storm masses: clouds adrift in the sky, swells and green shoals
		// moving under the water, and low banks smearing across the horizon
		masses = [];
		for (let i = 0; i < 15; i++) {
			const dark = i % 3 !== 2;
			masses.push({
				x0: Math.random() * W,
				y: yh * (0.06 + Math.random() * 0.78),
				rx: W * (0.1 + Math.random() * 0.2),
				ry: H * (0.03 + Math.random() * 0.075),
				rot: (Math.random() - 0.5) * 0.24,
				drift: 4 + Math.random() * 9,
				a: dark ? 0.26 + Math.random() * 0.2 : 0.12 + Math.random() * 0.12,
				rgb: dark ? [4, 13, 24] : [82, 132, 184],
			});
		}
		for (let i = 0; i < 3; i++) {
			masses.push({
				x0: Math.random() * W,
				y: yh * (0.9 + Math.random() * 0.13),
				rx: W * (0.2 + Math.random() * 0.2),
				ry: H * (0.03 + Math.random() * 0.05),
				rot: 0,
				drift: 5 + Math.random() * 7,
				a: 0.24 + Math.random() * 0.16,
				rgb: [4, 13, 24],
			});
		}
		for (let i = 0; i < 10; i++) {
			const roll = Math.random();
			const rgb =
				roll < 0.4 ? [4, 12, 24] : roll < 0.75 ? [110, 160, 205] : [46, 108, 94];
			masses.push({
				x0: Math.random() * W,
				y: yh + (H - yh) * (0.08 + Math.random() * 0.75),
				rx: W * (0.1 + Math.random() * 0.2),
				ry: (H - yh) * (0.05 + Math.random() * 0.1),
				rot: 0,
				drift: 8 + Math.random() * 20,
				a:
					roll < 0.4 ? 0.2 + Math.random() * 0.16 : 0.1 + Math.random() * 0.1,
				rgb,
			});
		}
		// squall veils: rain curtains raking from the sky down through
		// the horizon, binding the two fields together
		for (let i = 0; i < 4; i++) {
			masses.push({
				x0: Math.random() * W,
				y: yh * (0.6 + Math.random() * 0.35),
				rx: W * (0.05 + Math.random() * 0.06),
				ry: H * (0.16 + Math.random() * 0.14),
				rot: -0.32 + Math.random() * 0.18,
				drift: 6 + Math.random() * 8,
				a: 0.14 + Math.random() * 0.12,
				rgb: [6, 16, 28],
			});
		}
	}

	function wrap(x: number, span: number) {
		const m = W + span * 2;
		return ((((x + span) % m) + m) % m) - span;
	}

	// the waterline heaves; it is never a straight edge
	function seaEdgeY(x: number, yh: number) {
		return (
			yh +
			Math.sin(x * 0.0025 - t * 0.3) * H * 0.011 +
			Math.sin(x * 0.006 + t * 0.5) * H * 0.018 +
			Math.sin(x * 0.017 - t * 0.8) * H * 0.01 +
			Math.sin(x * 0.041 + t * 1.3) * H * 0.004 +
			Math.sin(x * 0.13 + t * 2.1) * H * 0.0016 +
			Math.sin(x * 0.31 - t * 1.7) * H * 0.001
		);
	}

	function paintSplotch(d: Splotch) {
		// foam moves at half tempo so it lingers instead of racing
		const tempo = d.kind === 3 ? 0.5 : 1;
		const x = wrap(d.x0 + d.drift * tempo * t, d.span);
		const y =
			d.y0 +
			Math.sin(t * (0.35 + d.flick * 0.4) * tempo + d.phase + d.x0 * 0.008) *
				(1.5 + 8 * d.v);
		let a: number;
		if (d.kind === 3) {
			// foam lives and dies with the gusts
			const gust = Math.max(0, Math.sin(t * d.flick * 0.8 + d.phase));
			a = d.a * gust * gust;
		} else {
			a = d.a * (0.65 + 0.35 * Math.sin(t * d.flick + d.phase));
		}
		if (a < 0.01) return;
		const [r, g, b] = d.rgb;
		ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${a})`;
		if (d.path) {
			// one connected ribbon: smooth along the top edge, back along
			// the bottom, so the foam smears instead of dotting
			const pts = d.path;
			const n = pts.length;
			ctx.beginPath();
			ctx.moveTo(x + pts[0].x, y + pts[0].y - pts[0].r);
			for (let i = 1; i < n - 1; i++) {
				const cx = x + pts[i].x;
				const cy = y + pts[i].y - pts[i].r;
				const mx = x + (pts[i].x + pts[i + 1].x) / 2;
				const my =
					y + (pts[i].y - pts[i].r + pts[i + 1].y - pts[i + 1].r) / 2;
				ctx.quadraticCurveTo(cx, cy, mx, my);
			}
			ctx.lineTo(x + pts[n - 1].x, y + pts[n - 1].y - pts[n - 1].r);
			ctx.lineTo(x + pts[n - 1].x, y + pts[n - 1].y + pts[n - 1].r);
			for (let i = n - 2; i > 0; i--) {
				const cx = x + pts[i].x;
				const cy = y + pts[i].y + pts[i].r;
				const mx = x + (pts[i].x + pts[i - 1].x) / 2;
				const my =
					y + (pts[i].y + pts[i].r + pts[i - 1].y + pts[i - 1].r) / 2;
				ctx.quadraticCurveTo(cx, cy, mx, my);
			}
			ctx.closePath();
			ctx.fill();
			return;
		}
		for (const bl of d.blobs) {
			ctx.beginPath();
			ctx.ellipse(x + bl.dx, y + bl.dy, bl.rx, bl.ry, bl.rot, 0, TAU);
			ctx.fill();
		}
	}

	function paintMass(m: Mass) {
		const x = wrap(m.x0 + m.drift * t, m.rx);
		const breathe = 1 + 0.12 * Math.sin(t * 0.07 + m.y);
		const [r, g, b] = m.rgb;
		const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, 1);
		grad.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${m.a * breathe})`);
		grad.addColorStop(1, `rgba(${r}, ${g}, ${b}, 0)`);
		ctx.save();
		ctx.translate(x, m.y);
		if (m.rot) ctx.rotate(m.rot);
		ctx.scale(m.rx, m.ry);
		ctx.fillStyle = grad;
		ctx.beginPath();
		ctx.arc(0, 0, 1, 0, TAU);
		ctx.fill();
		ctx.restore();
	}

	function paint() {
		const yh = horizonY();

		// sky: darkest overhead, gathering light toward the water
		const sky = ctx.createLinearGradient(0, 0, 0, yh * 1.06);
		sky.addColorStop(0, "#081625");
		sky.addColorStop(0.55, "#102a4a");
		sky.addColorStop(1, "#1d4674");
		ctx.fillStyle = sky;
		ctx.fillRect(0, 0, W, yh + H * 0.05);

		// sea laid over the sky along a heaving edge
		const sea = ctx.createLinearGradient(0, yh - H * 0.03, 0, H);
		sea.addColorStop(0, "#2a5c8c");
		sea.addColorStop(0.3, "#173a61");
		sea.addColorStop(1, BG);
		ctx.fillStyle = sea;
		ctx.beginPath();
		ctx.moveTo(0, H);
		for (let x = 0; x <= W + 14; x += 14) {
			ctx.lineTo(x, seaEdgeY(x, yh));
		}
		ctx.lineTo(W, H);
		ctx.closePath();
		ctx.fill();

		// storm masses, painted over the waterline so the low banks
		// smear sky into sea
		for (const m of masses) paintMass(m);

		// a soft seam of light, brightest where the two fields collide
		const pulse = 0.75 + 0.25 * Math.sin(t * 0.11);
		const seam = ctx.createLinearGradient(0, yh - H * 0.1, 0, yh + H * 0.06);
		seam.addColorStop(0, "rgba(125, 175, 220, 0)");
		seam.addColorStop(0.58, `rgba(150, 195, 232, ${0.28 * pulse})`);
		seam.addColorStop(0.75, `rgba(120, 170, 215, ${0.12 * pulse})`);
		seam.addColorStop(1, "rgba(120, 170, 215, 0)");
		ctx.fillStyle = seam;
		ctx.fillRect(0, yh - H * 0.1, W, H * 0.16);

		// the water: splotched, broken, all of it moving
		for (const d of dabs) paintSplotch(d);
		for (const d of churn) paintSplotch(d);
		for (const d of wakes) paintSplotch(d);

		// dissolve into the page
		const fade = ctx.createLinearGradient(0, H * 0.9, 0, H);
		fade.addColorStop(0, "rgba(12, 31, 51, 0)");
		fade.addColorStop(1, BG);
		ctx.fillStyle = fade;
		ctx.fillRect(0, H * 0.9, W, H * 0.1);
	}

	function frame(now: number) {
		const dt = Math.min((now - last) / 1000, 0.05);
		last = now;
		t += dt;
		paint();
		raf = running ? requestAnimationFrame(frame) : 0;
	}

	function start() {
		if (running || reduced) return;
		running = true;
		last = performance.now();
		raf = requestAnimationFrame(frame);
	}

	function stop() {
		running = false;
		if (raf) cancelAnimationFrame(raf);
		raf = 0;
	}

	resize();
	paint();
	if (!reduced) {
		const hero = canvas.closest(".hero")!;
		new IntersectionObserver(
			(entries) => (entries[0].isIntersecting ? start() : stop()),
		).observe(hero);
	}

	let resizeTimer = 0;
	window.addEventListener("resize", () => {
		clearTimeout(resizeTimer);
		resizeTimer = window.setTimeout(() => {
			stop();
			resize();
			paint();
			if (!reduced) start();
		}, 200);
	});
</script>
